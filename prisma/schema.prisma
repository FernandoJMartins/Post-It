// Postador Insta — schema (fonte da verdade dos agendamentos).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AccountStatus {
  CONNECTED
  DISCONNECTED
  TOKEN_EXPIRED
  REAUTH_REQUIRED
  ERROR
  SUSPENDED
  PAUSED
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PROCESSING
  PUBLISHING
  PUBLISHED
  FAILED
  FAILED_PERMANENTLY
  CANCELLED
  RETRYING
  UNKNOWN
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  timezone     String     @default("America/Fortaleza")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  accounts      InstagramAccount[]
  media         Media[]
  posts         Post[]
  auditLogs     AuditLog[]
  notifications Notification[]
  groups        AccountGroup[]
  templates     ScheduleTemplate[]
  recurring     RecurringSchedule[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // POST_PUBLISHED, POST_FAILED, MEDIA_READY, ACCOUNT_DISCONNECTED...
  title     String
  body      String?
  resourceId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AccountGroup {
  id        String             @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  InstagramAccount[]

  @@index([userId])
}

model ScheduleTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  timeOfDay String // "18:30"
  caption   String?
  hashtags  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum RecurrenceRule {
  DAILY
  WEEKDAYS
  WEEKLY
}

// Recorrência + fila de conteúdo (README 62, 63, 64): rotaciona uma lista de
// vídeos num horário recorrente. Ocorrências criadas sob demanda (nunca em massa).
model RecurringSchedule {
  id                String         @id @default(cuid())
  userId            String
  accountId         String
  name              String
  rule              RecurrenceRule
  weekday           Int? // 0-6 (dom-sáb) quando rule = WEEKLY
  timeOfDay         String // "18:30" no fuso abaixo
  timezone          String         @default("America/Fortaleza")
  mediaIds          String[]       @default([]) // fila em rotação
  cursor            Int            @default(0)
  active            Boolean        @default(true)
  lastOccurrenceKey String? // "YYYY-MM-DD@HH:MM" já processada
  createdAt         DateTime       @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
}

model InstagramAccount {
  id                    String        @id @default(cuid())
  userId                String
  groupId               String?
  platform              String        @default("instagram")
  username              String
  displayName           String?
  profilePictureUrl     String?
  externalAccountId     String?
  accessTokenEncrypted  String? // AES-256-GCM, nunca em texto puro
  tokenExpiresAt        DateTime?
  status                AccountStatus @default(DISCONNECTED)
  connectionStatus      String?
  timezone              String        @default("America/Fortaleza")
  defaultCaption        String?
  defaultHashtags       String?
  postingEnabled        Boolean       @default(true)
  notificationsEnabled  Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  lastSyncAt            DateTime?
  deletedAt             DateTime?

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      AccountGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  posts      Post[]
  recurring  RecurringSchedule[]

  @@index([userId])
  @@index([groupId])
}

model Media {
  id              String      @id @default(cuid())
  userId          String
  fileUrl         String?
  storageKey      String
  filename        String
  mimeType        String?
  sizeBytes       BigInt?
  durationSeconds Int?
  width           Int?
  height          Int?
  thumbnailUrl    String?
  status          MediaStatus @default(UPLOADING)
  tags            String[]    @default([])
  createdAt       DateTime    @default(now())
  deletedAt       DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

model Post {
  id                 String     @id @default(cuid())
  userId             String
  instagramAccountId String
  mediaId            String
  caption            String?
  scheduledAt        DateTime // sempre UTC
  timezone           String     @default("America/Fortaleza")
  status             PostStatus @default(DRAFT)
  publishedAt        DateTime?
  externalPostId     String?
  idempotencyKey     String     @unique
  errorCode          String?
  errorMessage       String?
  attemptCount       Int        @default(0)
  lockedBy           String?
  lockedAt           DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  media    Media                @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  attempts PublicationAttempt[]

  // Index composto usado pelo scheduler (README 114).
  @@index([instagramAccountId, status, scheduledAt])
  @@index([userId])
  @@index([status, scheduledAt])
}

model PublicationAttempt {
  id                 String     @id @default(cuid())
  postId             String
  attemptNumber      Int
  startedAt          DateTime   @default(now())
  finishedAt         DateTime?
  status             PostStatus
  errorCode          String?
  errorMessage       String?
  externalResponseId String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
